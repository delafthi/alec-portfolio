{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 4
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentWidth": 2
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.astro",
      "**/*.html",
      "**/*.json",
      "**/*.mjs",
      "!.astro",
      "!.direnv",
      "!.rumdl_cache",
      "!dist",
      "!node_modules",
      "!.netlify"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useConst": "off",
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
