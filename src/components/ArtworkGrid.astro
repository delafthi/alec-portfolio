---
import type { Lang } from "@i18n/ui";
import { ui } from "@i18n/ui";
import type { ArtworkEntry, TagEntry } from "@lib/content";
import { computeFilterOptions } from "@lib/filters";
import {
  AVAILABILITY_LABELS,
  MATERIAL_GROUP_LABELS,
  MATERIAL_GROUP_MAP,
} from "@lib/lookups";
import ArtworkCard from "./ArtworkCard.astro";

interface Props {
  artworks: ArtworkEntry[];
  lang: Lang;
  detailBasePath: string;
  tags?: TagEntry[];
}

const { artworks, lang, detailBasePath, tags = [] } = Astro.props;
const t = ui[lang];

const { visibleTags, visibleGroups, visibleAvailability } =
  computeFilterOptions(artworks, tags);
const hasFilters =
  visibleTags.length > 0 ||
  visibleGroups.length > 0 ||
  visibleAvailability.length > 0;
---

{hasFilters && (
    <div class="relative mb-8 flex justify-center">
      <div class="flex flex-nowrap gap-2 justify-center items-center w-full" id="tag-filters">
        <button
          id="more-filters-btn"
          type="button"
          class="tag-btn more-btn flex-none"
          aria-expanded="false"
          data-label={t.label}
        >{t.label}</button>
      </div>
      <div id="more-filters-panel" class="more-panel" style="display:none" aria-hidden="true">
        <button type="button" class="tag-btn active flex-none" data-filter="all" data-filter-type="all">
          {t.all}
        </button>
        {visibleTags.length > 0 && (
          <>
            <span class="filter-divider flex-none" aria-hidden="true" data-divider />
            {visibleTags.map((tag) => (
              <button type="button" class="tag-btn flex-none" data-filter={tag.id} data-filter-type="tag" data-group="tag">
                {tag.data.label[lang]}
              </button>
            ))}
          </>
        )}
        {visibleGroups.length > 0 && (
          <>
            <span class="filter-divider flex-none" aria-hidden="true" data-divider />
            {visibleGroups.map((group) => (
              <button type="button" class="tag-btn flex-none" data-filter={group} data-filter-type="material" data-group="material">
                {MATERIAL_GROUP_LABELS[group][lang]}
              </button>
            ))}
          </>
        )}
        {visibleAvailability.length > 0 && (
          <>
            <span class="filter-divider flex-none" aria-hidden="true" data-divider />
            {visibleAvailability.map((key) => (
              <button type="button" class="tag-btn flex-none" data-filter={key} data-filter-type="availability" data-group="availability">
                {AVAILABILITY_LABELS[key][lang]}
              </button>
            ))}
          </>
        )}
      </div>
    </div>
  )}

<div class="flex flex-wrap items-center gap-2" id="artwork-grid">
  {artworks.map((artwork) => (
      <ArtworkCard
        title={artwork.data.title[lang]}
        image={artwork.data.image}
        availability={artwork.data.availability}
        lang={lang}
        detailPath={`${detailBasePath}/${artwork.id}/`}
        tags={artwork.data.tags ?? []}
        materialGroup={MATERIAL_GROUP_MAP[artwork.data.materials]}
      />
    ))}
  <div class="grow-[10]" aria-hidden="true"></div>
</div>

<style>
.tag-btn {
  padding: 0.375rem 1rem;
  font-size: 0.8125rem;
  border: 1px solid color-mix(in srgb, var(--color-foreground) 25%, transparent);
  color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  transition:
    border-color 150ms,
    color 150ms;
  background: transparent;
  cursor: pointer;
  white-space: nowrap;
}
.tag-btn:hover {
  border-color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
  color: var(--color-foreground);
}
.tag-btn.active {
  border-color: var(--color-foreground);
  color: var(--color-foreground);
  font-weight: 600;
}
.filter-divider {
  display: inline-block;
  width: 1px;
  height: 1.25rem;
  background: color-mix(in srgb, var(--color-foreground) 20%, transparent);
  margin: 0 0.25rem;
  align-self: center;
}
.more-panel {
  position: absolute;
  top: calc(100% + 0.5rem);
  left: 50%;
  transform: translateX(-50%);
  background: var(--color-background);
  border: 1px solid color-mix(in srgb, var(--color-foreground) 20%, transparent);
  padding: 0.75rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center;
  z-index: 10;
  min-width: 12rem;
  max-width: min(28rem, 90vw);
  box-shadow: 0 4px 12px
    color-mix(in srgb, var(--color-foreground) 8%, transparent);
}
.more-panel .filter-divider {
  width: 100%;
  height: 1px;
  margin: 0.125rem 0;
}

#artwork-grid :global(.artwork-card) {
  flex-grow: var(--ratio);
  flex-basis: calc(var(--ratio) * 280px); /* row height */
  min-width: 150px;
}

@media (max-width: 639px) {
  #artwork-grid :global(.artwork-card) {
    flex-grow: 1;
    flex-basis: 100%;
    min-width: 0;
  }
}
</style>

<script>
import {
  type ActiveFilters,
  buildActiveFilterUrl,
  isFiltersEmpty,
  matchesActiveFilters,
  parseActiveFilters,
} from "@lib/filters";
import { once, onPageLoad } from "@lib/page-load";

function filterCards(cards: NodeListOf<HTMLElement>, f: ActiveFilters) {
  cards.forEach((c) => {
    const tags = c.dataset.tags?.split(" ").filter(Boolean) ?? [];
    c.style.display = matchesActiveFilters(
      tags,
      c.dataset.materialGroup ?? "",
      c.dataset.availability ?? "",
      f,
    )
      ? ""
      : "none";
  });
}

// Hide filtered cards in the incoming document before it is swapped in, so
// the layout is already stable when ClientRouter restores the scroll
// position — applying them only after the swap would shift the page.
document.addEventListener("astro:before-swap", (e) => {
  const { newDocument, to } = e as unknown as {
    newDocument: Document;
    to: URL;
  };
  const newGrid = newDocument.getElementById("artwork-grid");
  if (newGrid)
    filterCards(
      newGrid.querySelectorAll<HTMLElement>(".artwork-card"),
      parseActiveFilters(to.search),
    );
});

// Filter state is mirrored into the URL query, so returning to the grid via
// history navigation restores it.
onPageLoad(() => {
  const grid = document.getElementById("artwork-grid");
  if (!grid) return;
  const cards = grid.querySelectorAll<HTMLElement>(".artwork-card");
  const filterRow = document.getElementById("tag-filters");
  const moreBtn = document.getElementById(
    "more-filters-btn",
  ) as HTMLButtonElement | null;
  const morePanel = document.getElementById("more-filters-panel");
  const filterLabel = moreBtn?.dataset.label ?? "Filter";

  let activeFilters = parseActiveFilters(window.location.search);

  // document persists across transitions; scope its listener to this run.
  const ac = new AbortController();

  function syncButtonState() {
    const btns =
      morePanel?.querySelectorAll<HTMLButtonElement>(".tag-btn[data-filter]") ??
      [];
    btns.forEach((btn) => {
      const type = btn.dataset.filterType as "all" | keyof ActiveFilters;
      const active =
        type === "all"
          ? isFiltersEmpty(activeFilters)
          : activeFilters[type] === btn.dataset.filter;
      btn.classList.toggle("active", active);
    });

    if (moreBtn) {
      const count = Object.values(activeFilters).filter(Boolean).length;
      moreBtn.textContent =
        count > 0 ? `${filterLabel} (${count})` : filterLabel;
      moreBtn.classList.toggle("active", count > 0);
    }
  }

  function applyFilters() {
    filterCards(cards, activeFilters);
    cards.forEach((c) => {
      const link = c.querySelector("a");
      if (link) link.href = buildActiveFilterUrl(link.href, activeFilters);
    });
    syncButtonState();
  }

  function handleFilterClick(btn: HTMLButtonElement) {
    const type = btn.dataset.filterType as "all" | keyof ActiveFilters;
    const filter = btn.dataset.filter as string;

    activeFilters =
      type === "all"
        ? { tag: null, material: null, availability: null }
        : ({
            ...activeFilters,
            [type]: activeFilters[type] === filter ? null : filter,
          } as ActiveFilters);

    // Persist in the grid's history entry so back navigation restores it.
    // Keep the existing state: ClientRouter stores {index, scrollY} there.
    history.replaceState(
      history.state,
      "",
      buildActiveFilterUrl(window.location.href, activeFilters),
    );
    applyFilters();
  }

  function setPanelOpen(open: boolean) {
    if (!morePanel || !moreBtn) return;
    morePanel.style.display = open ? "" : "none";
    morePanel.setAttribute("aria-hidden", String(!open));
    moreBtn.setAttribute("aria-expanded", String(open));
  }

  moreBtn?.addEventListener("click", () =>
    setPanelOpen(morePanel?.style.display === "none"),
  );

  document.addEventListener(
    "click",
    (e) => {
      if (
        !filterRow?.contains(e.target as Node) &&
        !morePanel?.contains(e.target as Node)
      ) {
        setPanelOpen(false);
      }
    },
    { signal: ac.signal },
  );

  morePanel?.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>(".tag-btn");
    if (btn) handleFilterClick(btn);
  });

  applyFilters();

  return () => ac.abort();
});

// Remember the grid's history index on every navigation away from it, so the
// artwork page's back link can do a real history traversal — ClientRouter
// restores the scroll position natively for history entries.
once("__alecGridNav", () => {
  document.addEventListener("astro:before-preparation", (e) => {
    const from = (e as { from: URL }).from;
    if (/\/portfolio\/?$/.test(from.pathname)) {
      sessionStorage.setItem("alec:grid-index", String(history.state?.index));
    }
  });
});
</script>
