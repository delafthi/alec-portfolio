---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Lang } from "@i18n/ui";
import { ui } from "@i18n/ui";

interface Props {
  lang: Lang;
  email: string;
}

const { lang, email } = Astro.props;
const t = ui[lang];
const successPage = `${getRelativeLocaleUrl(lang, "/contact-thanks")}/`;
---

<div class="max-w-xl mx-auto px-6 py-10">
  <form
    name="contact"
    method="POST"
    action={successPage}
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-interest-template={t.interest_message}
    class="flex flex-col gap-6"
  >
    <input type="hidden" name="form-name" value="contact">
    <input type="hidden" name="artwork" id="artwork-field">
    <p class="hidden">
      <label>Don't fill this out: <input name="bot-field"></label>
    </p>

    <div class="flex flex-col gap-1.5">
      <label for="name" class="text-sm font-medium">{t.name}</label>
      <input
        id="name"
        type="text"
        name="name"
        required
        class="px-3 py-2 text-sm border focus:outline-none"
        style="border-color: color-mix(in srgb, var(--color-accent) 40%, transparent); background: var(--color-background); color: var(--color-foreground);"
      >
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="email" class="text-sm font-medium">{t.email}</label>
      <input
        id="email"
        type="email"
        name="email"
        required
        class="px-3 py-2 text-sm border focus:outline-none"
        style="border-color: color-mix(in srgb, var(--color-accent) 40%, transparent); background: var(--color-background); color: var(--color-foreground);"
      >
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="message" class="text-sm font-medium">{t.message}</label>
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        class="px-3 py-2 text-sm border resize-y focus:outline-none"
        style="border-color: color-mix(in srgb, var(--color-accent) 40%, transparent); background: var(--color-background); color: var(--color-foreground);"
      ></textarea>
    </div>

    <button
      type="submit"
      class="self-start px-8 py-2.5 text-sm font-medium transition-opacity hover:opacity-70"
      style="background-color: var(--color-foreground); color: var(--color-background);"
    >
      {t.send}
    </button>
  </form>

  {email && (
    <p
      class="mt-10 pt-6 text-sm text-center"
      style="border-top: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent); color: var(--color-accent);"
    >
      {t.email_direct}{' '}
      <a href={`mailto:${email}`} class="hover:opacity-70 transition-opacity">{email}</a>
    </p>
  )}
</div>

<script>
const form = document.querySelector<HTMLFormElement>("form[name='contact']");
const artwork = new URLSearchParams(window.location.search).get("artwork");

if (form && artwork) {
  const artworkField = form.querySelector<HTMLInputElement>(
    "input[name='artwork']",
  );
  if (artworkField) artworkField.value = artwork;

  const message = form.querySelector<HTMLTextAreaElement>("#message");
  const template = form.dataset.interestTemplate;
  if (message && !message.value && template) {
    message.value = template.replace("{artwork}", artwork);
  }
}
</script>
