---
import type { Lang } from "../i18n/ui";
import { ui } from "../i18n/ui";

interface Props {
  title: string;
  venue: string;
  city: string;
  date_start: Date;
  date_end: Date;
  type: "solo" | "gruppe";
  url?: string;
  description?: string;
  lang: Lang;
}

const {
  title,
  venue,
  city,
  date_start,
  date_end,
  type,
  url,
  description,
  lang,
} = Astro.props;
const t = ui[lang];

function formatDate(date: Date) {
  return date.toLocaleDateString(lang === "de" ? "de-DE" : "en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<li class="flex flex-col gap-2 pb-8" style="border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);">
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-2xl font-light">
      {url ? (
        <a href={url} target="_blank" rel="noopener noreferrer" class="hover:opacity-70 transition-opacity">
          {title}
        </a>
      ) : (
        title
      )}
    </h3>
    <span class="text-xs px-2 py-1 shrink-0" style="color: var(--color-accent); border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);">
      {t[`exhibition.type.${type}`]}
    </span>
  </div>
  <p class="text-sm font-medium" style="color: var(--color-accent);">
    {venue}, {city}
  </p>
  <p class="text-sm">
    {formatDate(date_start)} – {formatDate(date_end)}
  </p>
  {description && <p class="text-sm mt-1">{description}</p>}
</li>
