---
import type { Lang } from "@i18n/ui";
import { ui } from "@i18n/ui";
import { type ExhibitionEntry, splitExhibitions } from "@lib/content";
import { formatDateRange } from "@lib/date";

interface Props {
  exhibitions: ExhibitionEntry[];
  lang: Lang;
  exhibitionsPath: string;
}

const { exhibitions, lang, exhibitionsPath } = Astro.props;
const t = ui[lang];
const { upcoming } = splitExhibitions(exhibitions);
---

{upcoming.length > 0 && (
  <section
    id="exhibition-teaser"
    class="px-6 md:px-12 py-16"
    style="border-top: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);"
  >
    <h2 class="text-3xl font-light mb-8">{t.upcoming}</h2>
    <ul class="flex flex-col gap-6 max-w-2xl">
      {upcoming.map((ex) => (
        <li class="flex flex-col gap-1">
          <p class="text-xl font-light" style="font-family: var(--font-heading);">
            {ex.data.title}
            {ex.data.juried && (
              <span class="text-sm" style="color: var(--color-accent);">({t.juried})</span>
            )}
          </p>
          <p class="text-sm" style="color: var(--color-accent);">{ex.data.location}</p>
          <p class="text-sm">
            {formatDateRange(ex.data.startDate, ex.data.endDate, lang, { month: "long", year: "numeric" })}
          </p>
        </li>
      ))}
    </ul>
    <a
      href={exhibitionsPath}
      class="inline-block mt-8 text-sm underline underline-offset-4 hover:opacity-70 transition-opacity"
      style="color: var(--color-accent);"
    >
      {t.upcoming}
      →
    </a>
  </section>
)}
