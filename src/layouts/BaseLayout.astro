---
import { getRelativeLocaleUrl } from "astro:i18n";
import { ClientRouter } from "astro:transitions";
import InstagramIcon from "@components/InstagramIcon.astro";
import Nav from "@components/Nav.astro";
import { LANGS } from "@i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  lang: "de" | "en";
  description?: string;
  altLangUrl?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  lang,
  description = "Artworks by ALEC",
  altLangUrl,
  image,
  noindex = false,
} = Astro.props;
const fullTitle = `${title} — ALEC`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const otherLang = lang === "de" ? "en" : "de";
// Pages may pass an explicit altLangUrl; otherwise derive it from the current
// path, since all localized routes exist under both locale prefixes.
const localePrefixRe = new RegExp(`^/(?:${LANGS.join("|")})(?:/|$)`);
const altPath =
  altLangUrl ??
  (localePrefixRe.test(Astro.url.pathname)
    ? getRelativeLocaleUrl(otherLang, Astro.url.pathname.slice(3))
    : undefined);
// getRelativeLocaleUrl drops the trailing slash; canonical keeps it. Align
// the hreflang targets with the canonical form.
const altUrl = altPath
  ? new URL(altPath.endsWith("/") ? altPath : `${altPath}/`, Astro.site)
  : undefined;
const enUrl = lang === "en" ? canonicalUrl : altUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl}>
    <link rel="alternate" hreflang={lang} href={canonicalUrl}>
    {altUrl && <link rel="alternate" hreflang={otherLang} href={altUrl} />}
    {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:locale" content={lang === "de" ? "de_CH" : "en_GB"}>
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <Nav lang={lang} altLangUrl={altLangUrl} />
    <main class="mx-auto w-full max-w-7xl"><slot /></main>
    <footer class="py-8 px-6 text-center text-sm text-accent">
      <p class="mb-2">
        <a
          href="https://instagram.com/alec250661"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 hover:opacity-70 transition-opacity"
        >
          <InstagramIcon size={18} />
          <span>@alec250661</span>
        </a>
      </p>
      <p>
        &copy; {new Date().getFullYear()} ALEC. All artwork images are copyright
        of ALEC. All rights reserved.
      </p>
    </footer>
  </body>
</html>

<style>
footer {
  border-top: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
}
</style>
