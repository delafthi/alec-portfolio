---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="404" lang="en">
  <div class="flex flex-col items-center justify-center px-6 py-32 text-center">
    <h1 class="text-7xl font-light mb-6">404</h1>
    <p class="text-lg mb-2">This page was not found.</p>
    <p class="text-lg mb-8" style="color: var(--color-accent);">
      Diese Seite wurde nicht gefunden.
    </p>
    <div class="flex gap-4">
      <a
        href="/"
        class="px-6 py-2 text-sm transition-opacity hover:opacity-70"
        style="background: var(--color-foreground); color: var(--color-background);"
      >
        Home
      </a>
      <a
        href="/de/"
        class="px-6 py-2 text-sm transition-opacity hover:opacity-70"
        style="background: var(--color-foreground); color: var(--color-background);"
      >
        Startseite
      </a>
    </div>
  </div>
</BaseLayout>
