---
import { Image } from "astro:assets";
import type { Lang } from "@i18n/ui";
import { getStaticPaths, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAboutContent } from "@lib/content";
import alec from "../../assets/site/alec.png";

export { getStaticPaths };

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);

const Content = await getAboutContent(lang);
---

<BaseLayout title={t.about} lang={lang}>
  <div class="px-6 md:px-12 py-16 max-w-3xl mx-auto">
    <div class="flex flex-col md:flex-row md:gap-12 md:items-start">
      <div class="shrink-0 mx-auto md:mx-0 mb-8 md:mb-0">
        <Image src={alec} alt="ALEC" width={176} class="h-auto" />
      </div>
      <div>
        <h1 class="text-5xl font-light mb-8 text-center md:text-left">
          {t.about}
        </h1>
        <div
          style="font-size: 1rem; line-height: 1.75;"
          class="prose-paragraphs"
        >
          {Content && <Content />}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
