---
import { getRelativeLocaleUrl } from "astro:i18n";
import ArtworkDetail from "@components/ArtworkDetail.astro";
import { LANGS, type Lang } from "@i18n/ui";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  type ArtworkEntry,
  type ArtworkLightboxItem,
  getArtworks,
  toArtworkLightboxItems,
} from "@lib/content";

interface Props {
  artwork: ArtworkEntry;
  currentIndex: number;
  allArtworks: ArtworkLightboxItem[];
}

export async function getStaticPaths() {
  const artworks = await getArtworks();
  // Lightbox items depend only on lang; compute once per lang here instead
  // of once per page render (pages × langs would each re-loop the catalog).
  const paths = [];
  for (const lang of LANGS) {
    const allArtworks = await toArtworkLightboxItems(artworks, lang);
    for (const [currentIndex, artwork] of artworks.entries()) {
      paths.push({
        params: { lang, slug: artwork.id },
        props: { artwork, currentIndex, allArtworks },
      });
    }
  }
  return paths;
}

const lang = Astro.currentLocale as Lang;
const { artwork, currentIndex, allArtworks } = Astro.props;
const otherLang = lang === "de" ? "en" : "de";
const altLangUrl = getRelativeLocaleUrl(otherLang, `/artwork/${artwork.id}`);

const title = artwork.data.title[lang];
const notes = artwork.data.notes?.[lang];
---

<BaseLayout
  title={title}
  lang={lang}
  altLangUrl={altLangUrl}
  image={allArtworks[currentIndex]?.image}
>
  <ArtworkDetail
    title={title}
    image={artwork.data.image}
    year={artwork.data.year}
    month={artwork.data.month}
    size={artwork.data.size}
    materials={artwork.data.materials}
    notes={notes}
    availability={artwork.data.availability}
    lang={lang}
    currentIndex={currentIndex}
    allArtworks={allArtworks}
  />
</BaseLayout>
