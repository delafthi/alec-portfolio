---
import type { Lang } from "@i18n/ui";
import { getStaticPaths, useTranslations } from "@i18n/utils";
import BaseLayout from "@layouts/BaseLayout.astro";

export { getStaticPaths };

const lang = Astro.currentLocale as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t.contact} lang={lang} noindex>
  <div class="flex flex-col items-center justify-center px-6 py-32 text-center">
    <h1 class="text-4xl font-light mb-6">{t.success_title}</h1>
    <p class="text-lg mb-8" style="color: var(--color-accent);">
      {t.success}
    </p>
    <a
      href={`/${lang}/`}
      class="px-6 py-2 text-sm transition-opacity hover:opacity-70"
      style="background: var(--color-foreground); color: var(--color-background);"
    >
      {t.home}
    </a>
  </div>
</BaseLayout>
