---
import { ui } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";

const lang = "de";
const t = ui[lang];
---

<BaseLayout title={t['contact.title']} lang={lang}>
  <div class="flex flex-col items-center justify-center px-6 py-32 text-center">
    <h1 class="text-4xl font-light mb-6">{t['contact.success_title']}</h1>
    <p class="text-lg mb-8" style="color: var(--color-accent);">
      {t['contact.success']}
    </p>
    <a
      href="/de/"
      class="px-6 py-2 text-sm transition-opacity hover:opacity-70"
      style="background: var(--color-foreground); color: var(--color-background);"
    >
      Startseite
    </a>
  </div>
</BaseLayout>
